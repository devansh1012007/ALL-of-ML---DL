# The environment of the application. Copy this file to `.env` and fill in
# the values; `.env` is git-ignored.

# --- database ----------------------------------------------------------------
# The URL of the database. The default is a local SQLite file, which makes a
# fresh checkout runnable without any setup. It is read in
# backend/app/settings.py at import time, so a change needs a restart of the
# server.
#   SQLite (local):    sqlite+aiosqlite:///./backend.db
#   Postgres (docker): postgresql+asyncpg://user:password@db:5432/primetrade
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# --- authentication ----------------------------------------------------------
# The key the JWTs are signed with. It must never be a value that is published
# in the source: the "sub" claim of a token is the only thing that is
# verified, so anybody who knows the key can mint a token for any user.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production (APP_ENV=production) a missing key is a hard error. In
# development a random key is generated once and stored in `.secret_key`. It
# is read in backend/app/auth.py.
SECRET_KEY=

# "production" turns the missing SECRET_KEY into a startup error. Any other
# value (or none at all) keeps the development behaviour. It is read in
# backend/app/auth.py.
APP_ENV=development

# The alias of APP_ENV: "production" (or "prod") turns the missing SECRET_KEY
# into a startup error as well. It is read in backend/app/auth.py.
ENVIRONMENT=

# Where the development key is stored. The default is the repository root. It
# is read in backend/app/auth.py. An empty value is not the default: the path
# would become the current directory of the process, and the key would then
# not be persisted (a new key is generated at every start).
SECRET_KEY_FILE=

# --- CORS --------------------------------------------------------------------
# The origins that are allowed to call the API from a browser, separated by
# commas. The default is the development origins of the SPA (Vite serves it
# on port 3000). "*" opens the API to every origin and disables the
# credentials. It is read in backend/app/main.py at import time, so a change
# needs a restart of the server.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- limits ------------------------------------------------------------------
# The number of failed logins per address and account that are allowed per
# minute, and the number of registrations per address and minute. They are
# read in backend/app/main.py at import time, so a change needs a restart of
# the server.
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=20

# The number of uploads per client address and per minute. It is read in
# backend/app/main.py at import time, so a change needs a restart of the
# server.
UPLOAD_RATE_LIMIT=20

# The limits of an upload and of a dataset. They are read in
# backend/app/datasets.py at import time, so a change needs a restart of the
# server.
# The maximum size of an uploaded file, in bytes (50 MiB).
MAX_UPLOAD_BYTES=52428800
# The maximum number of data rows of an uploaded file.
MAX_UPLOAD_ROWS=2000000
# The maximum number of columns that are reported for a dataset.
MAX_REPORTED_COLUMNS=200

# The number of bytes the name of the client may have (default 200). A file
# name is at most 255 bytes, and the stored name is the generated one (32
# characters) followed by the name of the client.
MAX_FILE_NAME_BYTES=200

# The number of columns a file may have (default 1000). A file with a lot of
# columns takes gigabytes of memory to describe - one entry per column - and
# it is refused when its header is read.
MAX_UPLOAD_COLUMNS=1000

# --- datasets ----------------------------------------------------------------
# The directory every dataset is read from. A dataset is a row of the registry
# and its path is relative to this directory, so a dataset can never point
# outside of it. The default is the repository root: "data/" holds the
# datasets that ship with the repository, "uploads/" the files the users
# upload. It is read in backend/app/settings.py (datasets_root()) on every
# call, so a change does not need a restart.
# Set it to an absolute path to store the datasets somewhere else. An empty
# value is not the default: the root would become the current directory of
# the process.
DATASETS_ROOT=

# --- optional ----------------------------------------------------------------
# The key of the Google Gemini API, needed by the "llm_fine_tune" training
# mode. Without it that mode fails with an actionable message. It is read in
# backend/app/model_training.py.
GOOGLE_API_KEY=

# The Gemini model the "llm_fine_tune" mode asks for the hyperparameters.
# The default is gemini-pro. It is read in backend/app/model_training.py when
# the mode asks for the suggestions, so a change does not need a restart.
GOOGLE_MODEL=gemini-pro

# --- docker compose (backend/docker-compose.yml) ----------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=primetrade
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
