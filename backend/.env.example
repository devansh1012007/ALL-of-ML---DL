# The environment of the application. Copy this file to `.env` and fill in
# the values; `.env` is git-ignored.

# --- database ----------------------------------------------------------------
# The URL of the database. The default is a local SQLite file, which makes a
# fresh checkout runnable without any setup.
#   SQLite (local):    sqlite+aiosqlite:///./backend.db
#   Postgres (docker): postgresql+asyncpg://user:password@db:5432/primetrade
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# --- authentication ----------------------------------------------------------
# The key the JWTs are signed with. It must never be a value that is published
# in the source: the "sub" claim of a token is the only thing that is
# verified, so anybody who knows the key can mint a token for any user.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production (APP_ENV=production) a missing key is a hard error. In
# development a random key is generated once and stored in `.secret_key`.
SECRET_KEY=

# "production" turns the missing SECRET_KEY into a startup error. Any other
# value (or none at all) keeps the development behaviour.
APP_ENV=development

# Where the development key is stored. The default is the repository root.
SECRET_KEY_FILE=

# --- CORS --------------------------------------------------------------------
# The origins that are allowed to call the API from a browser, separated by
# commas. The default is the development origins of the SPA (Vite serves it
# on port 3000). "*" opens the API to every origin and disables the
# credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- limits ------------------------------------------------------------------
# The number of failed logins per address and account that are allowed per
# minute, and the number of registrations per address and minute.
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=20

# --- optional ----------------------------------------------------------------
# The key of the Google Gemini API, needed by the "llm_fine_tune" training
# mode. Without it that mode fails with an actionable message.
GOOGLE_API_KEY=

# --- docker compose (backend/docker-compose.yml) ----------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=primetrade
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
