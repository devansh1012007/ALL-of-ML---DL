# Root .dockerignore (SPEC blocker B5): keep local secrets and runtime data out of the
# root build context. The backend build context (backend/) uses backend/.dockerignore
# instead; this file does not apply to that build.
#
# Without this, a build copies whatever is on the developer's disk into the image:
# backend/.env, backend/.secret_key, backend/models/, data/uploads/.

.git
.github
.cache
.venv
**/.venv
**/node_modules
**/dist
**/__pycache__
**/*.pyc
frontend
docs
*.log

# secrets and keys (the example file is allowed back in)
**/.env
**/.env.*
!**/.env.example
**/.secret_key

# runtime data
backend/models
**/uploads
data/*.csv
!data/sample_*.csv
