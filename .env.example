# The environment of the whole stack. Copy this file to `.env` at the root of
# the repository and fill in the values; `.env` is git-ignored.
#
# This is the template of the root stack (postgres + api + worker of the root
# docker-compose.yml). The backend also keeps its own template,
# `backend/.env.example`, for a server that is started without compose.

# --- database ----------------------------------------------------------------
# The credentials of the `db` service (postgres:16) of the root
# docker-compose.yml. The user and the database default to "allml"; the password
# has no default and must be set here, or compose refuses to start.
POSTGRES_USER=allml
POSTGRES_PASSWORD=change-me
POSTGRES_DB=allml

# The URL of the database the api and the worker connect to. In this stack it
# points at the `db` service; the compose file sets it for both processes
# itself, so the credentials of the two must stay in sync.
DATABASE_URL=postgresql+asyncpg://allml:change-me@db:5432/allml

# --- authentication -----------------------------------------------------------
# The key the JWTs are signed with. It must never be a value that is published
# in the source: the "sub" claim of a token is the only thing that is
# verified, so anybody who knows the key can mint a token for any user.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production (APP_ENV=production) a missing key is a hard error. In
# development a random key is generated once and stored in `.secret_key`. It is
# read in backend/app/auth.py.
SECRET_KEY=

# "production" turns the missing SECRET_KEY into a startup error. Any other
# value (or none at all) keeps the development behaviour. It is read in
# backend/app/auth.py.
APP_ENV=development

# --- CORS ---------------------------------------------------------------------
# The origins that are allowed to call the API from a browser, separated by
# commas. The default is the development origins of the SPA (the Vite server of
# the frontend). "*" opens the API to every origin and disables the
# credentials. It is read in backend/app/main.py at import time, so a change
# needs a restart of the server.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- training -----------------------------------------------------------------
# The api of this stack never trains: the worker claims the queued runs from
# the database. docker-compose.yml sets TRAINING_IN_API=0 (the api enqueues
# only) and TRAINING_CONCURRENCY=1 (one worker slot); a second worker is one
# more service line, with more slots.
TRAINING_IN_API=0
TRAINING_CONCURRENCY=1

# --- reverse proxy ---------------------------------------------------------------
# The proxies the api trusts the client IP from; the compose default is the
# private range of the docker bridge network.
TRUSTED_PROXIES=172.16.0.0/12
